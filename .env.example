# Copy to .env and fill in. `npm start` reads it if it is there and starts
# without it if it is not, so nothing here is required to run the tests.
#
# .env is ignored by git. None of these belong in the repository.

# Signs the session cookie. Any 32+ characters; generate with
#   openssl rand -hex 32
ODW_SESSION_SECRET=

# The shared secret for the game server's internal API. This is *not* the game's
# token secret, which signs player tokens and never leaves that process — it is
# the one value both sides present to each other, and it must be identical to
# the game server's ODS_INTERNAL_TOKEN or every call here comes back 401.
ODW_GAME_INTERNAL_TOKEN=

# Where that API listens, and the address a player's client connects to. The
# first is private and must never be shown to anybody; the second is the one
# the site prints on the "how to connect" page.
ODW_GAME_INTERNAL_URL=http://127.0.0.1:8081
ODW_GAME_ADDRESS=http://127.0.0.1:8080

# `memory` needs no database and forgets everything when the process stops,
# which is right for trying the site out and wrong for anything else.
ODW_STORAGE=memory
# ODW_STORAGE=postgres
# ODW_DATABASE_URL=postgres://user:password@127.0.0.1:5432/open_dungeon

# Unset, the confirmation link is written to the log instead of posted, which is
# what makes signing up work on a laptop with no mail server. Set these and it
# is sent for real.
# ODW_SMTP_URL=smtp://user:password@host:587
# ODW_MAIL_FROM=no-reply@example.com
